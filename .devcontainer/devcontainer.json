{
  "name": "TNiC preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "TNiC preview", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "npm run dev",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
