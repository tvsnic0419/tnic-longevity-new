# Canonical URL — set in Vercel Production to https://tnic.help
NEXT_PUBLIC_SITE_URL=https://tnic.help

# ── Affiliate tagging (lib/affiliate.ts → /api/go redirect) ───────────────────
# Attaches your affiliate id to outbound product links. All optional; when unset
# the redirect is unchanged (no-op). Existing ids on a link are never overwritten.
#
# Amazon Associates store/tracking id (e.g. tnic-20) — applied to any amazon.* link
AMAZON_ASSOCIATES_TAG=
# Every other program that tracks via a query parameter, as a JSON array. Add an
# entry once a brand accepts you (see docs/SPONSOR_OUTREACH.md). Example:
#   TNIC_AFFILIATE_RULES=[{"domain":"iherb.com","param":"rcode","value":"ABC123"},{"domain":"thorne.com","param":"refID","value":"tnic"}]
# Programs that track via a full deep-link URL instead (ShareASale/Impact/CJ/
# Refersion) don't go here — paste the tracking URL into the pick's affiliateUrl.
TNIC_AFFILIATE_RULES=

# Google Search Console — HTML tag verification content (optional; DNS TXT also works)
GOOGLE_SITE_VERIFICATION=

# IndexNow key is committed at public/{INDEXNOW_KEY}.txt — see lib/indexnow.ts

# Protocol Brief — Resend native delivery (preferred when configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TNiC Protocol Brief <brief@send.tnic.help>
RESEND_AUDIENCE_ID=
BRIEF_FALLBACK_EMAIL=

# Brief unsubscribe HMAC — defaults to CRON_SECRET when unset
BRIEF_UNSUBSCRIBE_SECRET=

# Weekly cron — required in production; Vercel Cron sends Bearer automatically
CRON_SECRET=

# Protocol Brief — fallback webhook when Resend audience is not set
BRIEF_SUBSCRIBE_WEBHOOK_URL=

# Lab partner — required in production for POST /api/labs/partner/webhook
LAB_WEBHOOK_SECRET=

# Lab partner — OAuth client id for live partner redirects
LAB_OAUTH_CLIENT_ID=tnic

# Longevity Direct live OAuth (all required to enable live partner)
LONGEVITY_DIRECT_AUTHORIZE_URL=
LONGEVITY_DIRECT_TOKEN_URL=
LONGEVITY_DIRECT_ORDER_URL=
LONGEVITY_DIRECT_STATUS_URL=
LONGEVITY_DIRECT_CLIENT_ID=
LONGEVITY_DIRECT_CLIENT_SECRET=